        <calculation class='tableau' formula='IF [Equality_Score] &gt;= -10 AND [Equality_Score] &lt;= 10 THEN &quot;Fair&quot;&#10;ELSEIF [Equality_Score] &lt;= -20 OR [Equality_Score] &gt;= 20 THEN &quot;Highly Discriminative&quot;&#10;ELSE &quot;Unfair&quot;&#10;END' />
